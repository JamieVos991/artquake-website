# Instellingen voor art-quake.com op de Apache-server van Vimexx.
# Wordt door npm run build:vimexx in build-vimexx/ gezet.

Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On

# altijd via https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /artiesten -> artiesten.html, /agenda/abc -> agenda/abc.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# onbekende adressen (ook nieuwe activiteiten en oude artiestlinks):
# de site handelt ze zelf af via 404.html
ErrorDocument 404 /404.html

# bestanden in _app/immutable hebben een hash in de naam en veranderen nooit:
# lang bewaren. Pagina's altijd opnieuw controleren, zodat updates meteen te zien zijn.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_app/immutable/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
