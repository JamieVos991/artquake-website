# Instellingen voor art-quake.com op de Apache-server van Vimexx.
# Wordt door npm run build in build-vimexx/ gezet.

Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On

# altijd via https en zonder www (één adres, beter voor Google)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /artiesten -> artiesten.html, /agenda/abc -> agenda/abc.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# onbekende adressen (ook nieuwe activiteiten en oude artiestlinks):
# de site handelt ze zelf af via 404.html
ErrorDocument 404 /404.html

# bestanden in _app/immutable hebben een hash in de naam en veranderen nooit:
# lang bewaren. Pagina's altijd opnieuw controleren, zodat updates meteen te zien zijn.
<IfModule mod_headers.c>
  # Beveiliging: alleen via https (een jaar onthouden), niet in een frame van een
  # andere site, en scripts en verbindingen alleen naar de diensten die de site
  # gebruikt (Firebase/Google, Plausible). Komt er een nieuwe dienst bij, zet
  # die dan ook hier in script-src of connect-src.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "script-src 'self' 'unsafe-inline' https://plausible.io; connect-src 'self' https://*.googleapis.com https://plausible.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  <If "%{REQUEST_URI} =~ m#^/_app/immutable/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
