rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Beheerders: alleen accounts waarvan de UID als document in de collectie
    // "beheerders" staat. Alleen "ingelogd" is niet genoeg: zolang aanmelden
    // in Firebase aan staat, kan iedereen zelf een account maken. De UID (en
    // niet het e-mailadres) omdat iemand anders anders een account met het
    // e-mailadres van een crewlid zou kunnen maken. De UID vind je in de
    // Firebase-console onder Authentication > Users.
    function isBeheerder() {
      return request.auth != null
        && exists(/databases/$(database)/documents/beheerders/$(request.auth.uid));
    }

    // De lijst met beheerders zelf: alleen te beheren via de Firebase-console.
    // Een beheerder mag wel zijn eigen document lezen.
    match /beheerders/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Agenda en artiesten: publiek zichtbaar op de website, alleen beheerders
    // mogen ze aanmaken, wijzigen of verwijderen.
    match /agenda/{id} {
      allow read: if true;
      allow write: if isBeheerder();
    }
    match /artiesten/{id} {
      allow read: if true;
      allow write: if isBeheerder();
    }

    // Annuleren via de link in de bevestigingsmail (pagina /annuleren), zonder
    // inloggen. De link bevat de geheime annuleerCode van de reservering; de
    // bezoeker stuurt die mee als bevestigCode en mag dan alleen geannuleerd
    // op true zetten. Lezen kan de bezoeker de reservering niet.
    function magZelfAnnuleren() {
      return resource.data.get('annuleerCode', '') is string
        && resource.data.get('annuleerCode', '').size() >= 32
        && resource.data.get('geannuleerd', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['geannuleerd', 'geannuleerdOp', 'bevestigCode'])
        && request.resource.data.geannuleerd == true
        && request.resource.data.geannuleerdOp == request.time
        && request.resource.data.bevestigCode == resource.data.annuleerCode;
    }

    // Reserveringen bevatten namen en e-mailadressen. Reserveren kan op dit
    // moment alleen de crew (de pagina /reserveren vraagt om in te loggen),
    // dus alles alleen voor beheerders.
    //
    // Gaat reserveren later weer open voor iedereen, dan moeten hier
    // aangepaste regels komen: dan moet het boekingsformulier zonder login
    // bezette tijden kunnen zien. Doe dat bij voorkeur zonder namen en
    // e-mailadressen openbaar te maken (bv. een aparte collectie met alleen
    // studio, datum en tijden).
    match /reserveringen/{id} {
      allow read, delete: if isBeheerder();
      allow update: if isBeheerder() || magZelfAnnuleren();
      allow create: if isBeheerder()
                    && request.resource.data.keys().hasAll(
                         ['studio', 'naam', 'email', 'datum', 'starttijd', 'eindtijd']
                       )
                    && request.resource.data.studio is string
                    && request.resource.data.naam is string
                    && request.resource.data.email is string
                    && request.resource.data.datum is string
                    && request.resource.data.starttijd is string
                    && request.resource.data.eindtijd is string;
    }

    // Reserveringen in afwachting van de verificatiecode uit de e-mail.
    match /reserveringen_pending/{id} {
      allow read, update, delete: if isBeheerder();
      allow create: if isBeheerder()
                    && request.resource.data.keys().hasAll(
                         ['studio', 'naam', 'email', 'datum', 'starttijd', 'eindtijd', 'code', 'aangemaaktOp']
                       )
                    && request.resource.data.code is string
                    && request.resource.data.code.size() == 6;
    }

    // Al het andere staat standaard dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
