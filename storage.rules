rules_version = '2';

// Firebase Storage: de foto's van artiesten, crew en agenda.
service firebase.storage {
  match /b/{bucket}/o {

    // Zelfde beheerderslijst als in firestore.rules (collectie "beheerders",
    // document-ID = UID van het account).
    function isBeheerder() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/beheerders/$(request.auth.uid));
    }

    // Iedereen mag de foto's zien (ze staan op de website). Uploaden mag
    // alleen een beheerder, alleen gewone foto's (geen SVG: daar kan code in)
    // en maximaal 10 MB.
    match /{map}/{bestand} {
      allow read: if true;
      allow create, update: if isBeheerder()
                   && map in ['agenda-images', 'artiesten-images', 'crew-images']
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif|heic|heif)');
      allow delete: if isBeheerder();
    }

    // Al het andere staat standaard dicht.
    match /{allePaden=**} {
      allow read, write: if false;
    }
  }
}
